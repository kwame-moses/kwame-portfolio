# Copy to .env.local for `vercel dev`, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values.

# Required: Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Required: the inbox that receives contact-form messages
CONTACT_TO_EMAIL=

# Optional: sender address. Leave empty to use Resend's test sender
# (onboarding@resend.dev), which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=

# Optional (frontend): send the form somewhere other than /api/contact
# VITE_CONTACT_ENDPOINT=
